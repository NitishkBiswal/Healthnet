# ============================================================
# HealthNet Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_NAME=HealthNet
APP_VERSION=0.1.0
DEBUG=true

# PostgreSQL
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=<POSTGRES_DB>
DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
DATABASE_SYNC_URL=postgresql+psycopg2://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>

# Redis
REDIS_URL=redis://localhost:6379/0

# Keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=healthnet
KEYCLOAK_CLIENT_ID=<KEYCLOAK_CLIENT_ID>
KEYCLOAK_CLIENT_SECRET=<KEYCLOAK_CLIENT_SECRET>
KEYCLOAK_ADMIN_USER=<KEYCLOAK_ADMIN_USER>
KEYCLOAK_ADMIN_PASSWORD=<KEYCLOAK_ADMIN_PASSWORD>

# HAPI FHIR
HAPI_FHIR_BASE_URL=http://localhost:8090/fhir

# Security
SECRET_KEY=<GENERATE_A_SECURE_RANDOM_SECRET>
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000